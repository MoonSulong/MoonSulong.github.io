<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.username }}" class="github-user-card">
    <img
      class="github-avatar"
      alt="{{ include.username }}"
      src="https://github.com/{{ include.username }}.png?size=120"
      width="120"
      height="120"
    >
    <div class="github-username">{{ include.username }}</div>
  </a>
</div>
